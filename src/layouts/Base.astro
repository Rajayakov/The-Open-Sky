---
export interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'The Open Sky — by Yakov Rajuna',
  description = 'Retreats in sacred landscapes. Mountain journeys. Online programs. Personal mentorship. An ecosystem of transformational experiences founded by Yakov Rajuna.',
} = Astro.props;
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Source+Serif+4:ital,opsz,wght@0,8..60,300..700;1,8..60,300..700&family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,300;1,9..144,400;1,9..144,500;1,9..144,600&family=Inter+Tight:ital,wght@0,300;0,400;0,500;1,300;1,400&family=Syne:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <Analytics />
    <SpeedInsights />
  <meta name="robots" content="noindex, nofollow" />
  </head>

  <body>
    <!-- Grain: barely visible, purely atmospheric -->
    <canvas id="grain-canvas" width="200" height="200" style="display:none;" aria-hidden="true"></canvas>
    <div class="grain" id="grain-layer" aria-hidden="true"></div>

    <script is:inline>
      /* Рабочая версия сайта: вне продакшен-хостов показываем пометку «в разработке» */
      (function () {
        var h = location.hostname;
        if (/^(theopensky|the-open-sky|annapurna2027|annapurna-pilgrimage-2027|the-open-sky-rajuna|the-open-sky-git-main-rajuna)\.vercel\.app$/.test(h)) return;
        var b = document.createElement('div');
        b.setAttribute('role', 'note');
        b.style.cssText = 'position:fixed;left:12px;bottom:12px;z-index:9999;max-width:calc(100vw - 24px);padding:9px 14px;border-radius:10px;background:rgba(20,16,12,.88);color:#e9dfcc;font:12px/1.4 system-ui,sans-serif;letter-spacing:.02em;box-shadow:0 4px 18px rgba(0,0,0,.3);pointer-events:auto';
        b.innerHTML = 'В разработке · не для публики. Публично открыт только <a href="/mountains/annapurna-2027" style="color:#d6b46a">лендинг Аннапурны</a>';
        document.body.appendChild(b);
      })();
    </script>

    <slot />

    <script>
      /* Grain — subtle canvas noise */
      (function () {
        const c = document.getElementById('grain-canvas') as HTMLCanvasElement;
        const l = document.getElementById('grain-layer') as HTMLElement;
        if (!c || !l) return;
        const ctx = c.getContext('2d');
        if (!ctx) return;
        const img = ctx.createImageData(c.width, c.height);
        for (let i = 0; i < img.data.length; i += 4) {
          const v = Math.random() * 255 | 0;
          img.data[i] = img.data[i+1] = img.data[i+2] = v;
          img.data[i+3] = (Math.random() * 30 + 5) | 0;
        }
        ctx.putImageData(img, 0, 0);
        l.style.backgroundImage = `url(${c.toDataURL()})`;
      })();

      /* Scroll reveal */
      const io = new IntersectionObserver(
        (entries) => entries.forEach((e) => {
          if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
        }),
        { threshold: 0.08 }
      );
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
    </script>
  </body>
</html>
