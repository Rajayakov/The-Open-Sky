---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import '../../styles/global.css';

const TG = 'https://t.me/Rajuna_Yakov';
const WA = 'https://wa.me/66979525054';
const IG = 'https://instagram.com/yakov_rajuna';

const nb = ' ';

/* ── Content (source: approved PDF, RU, 2027) ───────── */

const intent = [
  ['Освобождение', 'От кармических узлов и ограничений.'],
  ['Пробуждение', 'Воссоединение с внутренней Силой.'],
  ['Центр', 'Возвращение в истинный центр — туда, где всё становится ясно.'],
  ['Стихии', 'Глубокое слияние со стихиями природы и живым полем Гималаев.'],
  ['Сознание', 'Переход на новый уровень и масштаб сознания — в чистый канал Духа.'],
];

const gains = [
  'Соединишься с внутренним источником силы, истины, покоя и правды',
  'Пробудишь прежде спящие ресурсы тела и духа',
  'Обретёшь ясность в ключевых вопросах своей жизни',
  'Напитаешься силой Гималаев и энергией пяти стихий — для дальнейших свершений',
  'Услышишь голос своей души и её истинные желания',
  'Проработаешь выбранное намерение и получишь ясность и заряд для его реализации',
  'Познакомишься с близкими по духу людьми',
  'Погрузишься в мир древнего шаманизма и исцеляющей магии',
];

const practices = [
  ['Утренний цигун', 'Пробуждение внутренней энергии'],
  ['Шаманские настройки', 'Во время переходов'],
  ['Вечерние медитации', 'На внутренний источник'],
  ['Групповые шеринги', 'Ответы на вопросы и наставления'],
  ['Церемонии с растениями силы', 'В Муктинатхе · углублённая программа'],
];

type Day = { date: string; place: string; alt: string; meta: string; text: string; peak?: boolean };
const days: Day[] = [
  { date: '27 марта', place: 'Pokhara', alt: `~820${nb}м`, meta: '', text: 'Встреча группы в Pokhara. Знакомство, вводная лекция, техника безопасности. Ночёвка в отеле.' },
  { date: '28 марта', place: 'Pokhara', alt: `~820${nb}м`, meta: '', text: 'Закупка снаряжения, оформление пермитов и документов. Ночёвка в отеле.' },
  { date: '29 марта', place: 'Pokhara → Chame', alt: `~2${nb}670${nb}м`, meta: '8–9 ч', text: 'Переезд по горной дороге. Вечером — горячие источники Chame. Открытие круга, закладка намерения, медитация и молитва.' },
  { date: '30 марта', place: 'Chame → Upper Pisang', alt: `~3${nb}300${nb}м`, meta: '5–6 ч', text: 'Живописные леса и виды на Аннапурну II.' },
  { date: '31 марта', place: 'Upper Pisang → Manang', alt: `3${nb}519${nb}м`, meta: `5–6 ч · +200${nb}м`, text: 'Верхняя тропа с панорамами всего массива Аннапурны.' },
  { date: '1 апреля', place: 'Manang · акклиматизация', alt: `3${nb}800–3${nb}900${nb}м`, meta: '3–4 ч', text: 'Радиальный выход к Ice Lake. Возвращение на ночёвку в Manang.' },
  { date: '2 апреля', place: 'Manang → Khangsar', alt: `3${nb}734${nb}м`, meta: `4–5 ч · +215${nb}м`, text: 'Переход в сторону долины Tilicho.' },
  { date: '3 апреля', place: 'Khangsar → Tilicho Base Camp', alt: `~3${nb}900${nb}м`, meta: `5–6 ч · +170${nb}м`, text: 'Переход через осыпные участки.' },
  { date: '4 апреля', place: 'Tilicho Lake → Shri Kharka', alt: `4${nb}920${nb}м`, meta: `6–8 ч · +1${nb}020 / −840${nb}м`, text: `Утренний выход к одному из самых высокогорных озёр мира. Ночёвка в Shri Kharka (~4${nb}080${nb}м).`, peak: true },
  { date: '5 апреля', place: 'Shri Kharka → Yak Kharka', alt: `~4${nb}110${nb}м`, meta: '4–5 ч', text: 'Минимальный набор высоты. Переход в сторону перевала.' },
  { date: '6 апреля', place: 'Yak Kharka → Thorong Phedi', alt: `~4${nb}600${nb}м`, meta: `3–4 ч · +500${nb}м`, text: 'Последний лагерь перед перевалом. Подготовка.' },
  { date: '7 апреля', place: 'Thorong La → Muktinath', alt: `5${nb}416${nb}м`, meta: `8–9 ч · +816 / −1${nb}600${nb}м`, text: `Главный инициационный переход маршрута — самый высокий и насыщенный день. Ночёвка в Muktinath (~3${nb}800${nb}м), высотная баня.`, peak: true },
  { date: '8 апреля', place: 'Muktinath · день силы', alt: `~3${nb}800${nb}м`, meta: '', text: 'Храм Муктинатх — место паломничества индуистов и буддистов. 108 священных источников, храмы Гумба Самба и Джвала Май. Интеграция опыта, финальный шеринг, закрытие круга, молитва.', peak: true },
  { date: '9 апреля', place: 'Muktinath → Pokhara', alt: `~820${nb}м`, meta: '6–8 ч / ~20 мин', text: 'Переезд через Jomsom или перелёт.' },
];

const deep = [
  ['11 апреля', 'Церемония с растением силы Амазонии', 'Аяуаска'],
  ['12 апреля', 'Групповой шеринг', 'Интеграция · баня · отдых'],
  ['13 апреля', 'Дневная церемония с кактусом Сан Педро', 'В горах'],
  ['14 апреля', 'Шеринг, интеграция, закрытие круга', 'Баня'],
  ['15 апреля', 'Джип Muktinath → Jomsom → Pokhara', ''],
];

const stats = [
  ['21+', 'лет на духовном пути'],
  ['400+', 'ретритов в местах силы'],
  [`4${nb}000+`, 'участников прошли путь'],
];

const guideBullets = [
  'Целитель, музыкант, специалист по работе с энергией',
  '10+ лет церемоний с растениями силы',
  'Инициации у шаманов Перу и Бразилии',
  'Глубокое погружение в традиции адвайты, мистических и шаманских линий передачи',
  'Предан миссии пробуждения, активации и исцеления сознания',
];

const safety = [
  ['Гид и команда', 'Профессиональный горный гид с опытом высотных маршрутов Гималаев. Пермиты ACAP и TIMS оформляются организаторами заранее.'],
  ['Налегке весь маршрут', 'Портеры несут весь основной груз на протяжении всего трека. С собой — только то, что нужно в течение дня. Силы и внимание остаются для внутреннего процесса.'],
  ['Медицина', 'Аптечка с высотными медикаментами, в том числе от горной болезни, всегда у гида. Акклиматизация встроена в маршрут: день отдыха в Manang, плавный набор высоты.'],
  ['Эвакуация', 'Эвакуационный план: вертолётные площадки на всём маршруте.'],
];

const mustKnow = [
  `Медицинская страховка с покрытием вертолётной эвакуации до 6${nb}000${nb}м — оплачивается отдельно, ~$100`,
  'Нормальная или хорошая физическая форма и готовность к многодневным переходам',
  'Предварительный видеозвонок с Яковом обязателен',
];

const plans = [
  { name: 'Основная программа', span: '14 дней · 27 марта – 9 апреля', price: `$2${nb}200`, note: 'Трек + трансформационная программа', best: false },
  { name: 'Углублённая программа', span: '6 дней · 10–15 апреля', price: `$1${nb}300`, note: '2 церемонии с растениями силы', best: false },
  { name: 'Полный путь', span: '20 дней · 27 марта – 15 апреля', price: `$3${nb}400`, note: 'Оптимальный вариант для глубокого прохождения и закрепления процесса. Выгода $100 к отдельным программам.', best: true },
];

const included = [
  'Гид сопровождения и портеры на всём маршруте',
  'Все пермиты (ACAP, TIMS)',
  'Джип Pokhara → Chame и Muktinath → Pokhara',
  'Проживание в лоджах на всём маршруте',
  '2 ночи с завтраком в Pokhara · 2 ночи с завтраком в Muktinath',
  '5 ночей в комфортном отеле (углублённая программа, 10–14 апреля)',
  'Высотная баня в Muktinath',
  'Утренний цигун и пробуждение внутренней энергии',
  'Работа с намерением (основной и углублённый этап)',
  'Шаманские настройки во время переходов',
  'Вечерние медитации на внутренний источник',
  'Групповые шеринги, наставления и ответы на вопросы',
  '2 церемонии с растениями силы: Аяуаска и Сан Педро',
  'Углублённые медитации и практики тишины',
  'Энергетические и телесные практики, интеграция опыта',
];

const excluded = [
  'Международный перелёт до/из Катманду',
  'Дорога до Pokhara: каждый добирается сам, джипом или самолётом',
  `Перелёт Jomsom → Pokhara вместо джипа (~$100, опционально)`,
  'Непальская виза (от $40) · нужна цветная фотография 3×4',
  'Медицинская страховка (~$100)',
  'Питание: $15–30 в день, кроме четырёх завтраков в Pokhara и Muktinath',
  'Личные расходы: питьевая вода $0,2–2 за литр, душ $2–5',
  'Личная экипировка и всё, что не указано в программе',
];

const faq = [
  ['Какая нужна физическая подготовка?', 'Нормальная или хорошая физическая форма и готовность к многодневным переходам. Маршрут требует выносливости, несмотря на то что портеры несут весь основной груз. С собой — только то, что нужно в течение дня.'],
  ['Что с высотой и безопасностью?', 'Группу ведёт профессиональный горный гид с опытом высотных маршрутов Гималаев. Акклиматизация встроена в маршрут: день отдыха в Manang и плавный набор высоты. Аптечка с высотными медикаментами всегда у гида, на всём маршруте есть вертолётные площадки. Страховка с покрытием эвакуации обязательна.'],
  ['Как добраться до Pokhara?', 'Каждый добирается сам — джипом или самолётом. Группа собирается в Pokhara 27 марта. Дальше джип до Chame и обратно из Muktinath входят в стоимость.'],
  ['Можно ли выбрать только одну часть?', 'Да. Основная программа — 14 дней трека, углублённая — 6 дней в Muktinath. Полный путь соединяет обе части: группа остаётся в Muktinath 9 апреля без выезда в Pokhara, и это на $100 выгоднее отдельных программ.'],
  ['Как попасть в группу?', 'Группа — до 15 человек, это не массовый формат. Участники отбираются осознанно: сначала короткое сообщение Якову, затем обязательный видеозвонок.'],
  ['Какие документы и расходы нужны заранее?', 'Непальская виза (от $40) с цветной фотографией 3×4, ещё две фотографии 3×4 для пермитов, медицинская страховка (~$100) и международный перелёт до Катманду. Питание в пути — $15–30 в день.'],
];

/* ── Altitude profile (nights) ──────────────────────── */

const prof = [820, 820, 2670, 3300, 3519, 3850, 3734, 3900, 4080, 4110, 4600, 3800, 3800, 820];
const W = 1000, H = 400, padX = 36, top = 56, base = 330, maxAlt = 5600;
const px = (i: number) => padX + (i * (W - padX * 2)) / (prof.length - 1);
const py = (a: number) => base - (a / maxAlt) * (base - top);
const line = prof.map((a, i) => `${i ? 'L' : 'M'}${px(i).toFixed(1)},${py(a).toFixed(1)}`).join(' ');
const area = `${line} L${px(prof.length - 1)},${base} L${px(0)},${base} Z`;
const peaks = [
  { i: 8, alt: 4920, l1: 'Tilicho Lake', l2: `4${nb}920${nb}м` },
  { i: 11, alt: 5416, l1: 'Thorong La', l2: `5${nb}416${nb}м` },
];
const marks = [
  { i: 0, t: 'Pokhara', a: 'start', dy: -14 },
  { i: 2, t: 'Chame', a: 'middle', dy: -14 },
  { i: 4, t: 'Manang', a: 'middle', dy: -14 },
  { i: 12, t: 'Muktinath', a: 'middle', dy: 28 },
  { i: 13, t: 'Pokhara', a: 'end', dy: -14 },
];
---

<Base
  lang="ru"
  title="Аннапурна 2027 — паломничество-инициация к Муктинатху — The Open Sky"
  description="Annapurna Circuit, Непал, 27 марта – 15 апреля 2027. Паломничество-инициация к священному Муктинатху с Яковом Раджуной. Группа до 15 человек."
>
  <Nav />
  <main class="an">

    <!-- 1. HERO -->
    <section class="an-hero" aria-label="Аннапурна 2027">
      <img
        class="an-hero__img"
        src="/images/mountains/annapurna-hero.jpg"
        alt="Гималаи, массив Аннапурны"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
      <div class="an-hero__overlay" aria-hidden="true"></div>

      <div class="an-hero__inner frame">
        <p class="an-kicker reveal d1">Непал · Annapurna Circuit · 2027</p>
        <h1 class="an-hero__title reveal d1">Аннапурна</h1>
        <p class="an-hero__sub reveal d2">Паломничество-инициация<br />к священному Муктинатху</p>
        <div class="an-hero__row reveal d3">
          <a href={TG} class="an-btn an-btn--gold" target="_blank" rel="noopener noreferrer">Подать заявку</a>
          <p class="an-hero__date">27 марта – 15 апреля 2027</p>
        </div>
      </div>

      <dl class="an-hero__facts frame" aria-label="Коротко о маршруте">
        <div><dt>Основной трек</dt><dd>14 дней</dd></div>
        <div><dt>Высшая точка</dt><dd>Thorong La · 5{nb}416{nb}м</dd></div>
        <div><dt>Цель</dt><dd>Muktinath · 108 источников</dd></div>
        <div><dt>Группа</dt><dd>до 15 человек</dd></div>
      </dl>
    </section>


    <!-- 2. ПИСЬМО -->
    <section class="an-letter" aria-label="Слово от Якова">
      <div class="frame an-letter__inner">
        <p class="an-label reveal">Намасте, дорогой Друг</p>
        <p class="an-letter__lead reveal d1">
          Я формирую группу людей, созревших к настоящей трансформации, — для священного паломничества-инициации в Непал.
        </p>
        <div class="an-letter__text">
          <p class="reveal">Путь пролегает через священные вершины Аннапурны — Богини плодородия — к Муктинатху: месту силы, где из скал бьют 108 источников и сходятся воедино пять стихий.</p>
          <p class="reveal">Это глубинная трансформация, исцеление и возвращение к своему истинному центру. Работа с выбранным внутренним и внешним намерением.</p>
          <p class="reveal">Путешествие для тех, кто слышит зов Духа и готов пройти его осознанно — позволяя силе Гималаев и духовным практикам преобразить себя под чутким руководством опытного проводника и шамана.</p>
        </div>
        <p class="an-letter__sig reveal">— Яков Раджуна</p>

        <blockquote class="an-quote reveal">
          <p>Это путешествие разделит твою жизнь на «до» и «после».</p>
          <footer>Полная перезагрузка тела, души и духа. Ты вернёшься обновлённым — с ясным пониманием своего пути.</footer>
        </blockquote>
      </div>
    </section>


    <!-- 3. НАМЕРЕНИЕ -->
    <section class="an-intent" aria-label="Намерение путешествия">
      <div class="frame">
        <h2 class="an-h2 reveal">Намерение<br />путешествия</h2>
        <p class="an-lead reveal d1">Паломничество открывает пространство для глубокой внутренней работы — в одном из самых мощных сакральных мест на Земле.</p>
        <div class="an-rows">
          {intent.map(([t, b], i) => (
            <div class={`an-row reveal d${(i % 3) + 1}`}>
              <h3 class="an-row__t">{t}</h3>
              <p class="an-row__b">{b}</p>
            </div>
          ))}
        </div>
      </div>
    </section>


    <!-- 4. ЧТО ТЫ ПОЛУЧИШЬ -->
    <section class="an-gain" aria-label="Что даст путешествие">
      <div class="frame">
        <h2 class="an-h2 reveal">В этом путешествии<br />ты</h2>
        <p class="an-lead reveal d1">Сбросишь то, что обременяло, — и освободишь место для нового.</p>
        <ol class="an-gain__list">
          {gains.map((g, i) => (
            <li class={`an-gain__item reveal d${(i % 2) + 1}`}>
              <span class="an-gain__n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <span class="an-gain__t">{g}</span>
            </li>
          ))}
        </ol>
      </div>
    </section>


    <!-- 5. ПРАКТИКИ -->
    <section class="an-prac" aria-label="Ежедневные практики">
      <div class="frame">
        <h2 class="an-h2 reveal">Ежедневные<br />практики</h2>
        <ul class="an-prac__list" role="list">
          {practices.map(([t, s], i) => (
            <li class={`an-prac__item reveal d${(i % 3) + 1}`}>
              <span class="an-prac__t">{t}</span>
              <span class="an-prac__s">{s}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>


    <!-- 6. МАРШРУТ -->
    <section class="an-route" id="route" aria-label="Маршрут">
      <div class="frame">
        <h2 class="an-h2 reveal">Маршрут</h2>
        <p class="an-lead reveal d1">Annapurna Circuit + Tilicho Lake · 14 дней · 27 марта – 9 апреля 2027. Старт и финиш — Pokhara.</p>

        <div class="an-chart reveal d2" role="img" aria-label="Профиль высот ночёвок: от Pokhara 820 метров до перевала Thorong La 5416 метров и обратно">
          <p class="an-chart__t">Профиль высот <span>— высота ночёвок, м. Пики дня отмечены точками.</span></p>
          <div class="an-chart__scroll">
            <svg viewBox={`0 0 ${W} ${H}`} class="an-chart__svg" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
              <defs>
                <linearGradient id="anArea" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0%" stop-color="#C4A862" stop-opacity="0.28" />
                  <stop offset="100%" stop-color="#C4A862" stop-opacity="0.01" />
                </linearGradient>
              </defs>
              {[1000, 3000, 5000].map(a => (
                <g>
                  <line x1={padX} x2={W - padX} y1={py(a)} y2={py(a)} class="an-chart__grid" />
                  <text x={W - padX} y={py(a) - 6} text-anchor="end" class="an-chart__ax">{a} м</text>
                </g>
              ))}
              <path d={area} fill="url(#anArea)" />
              <path d={line} class="an-chart__line" />
              {prof.map((a, i) => (
                <g>
                  <circle cx={px(i)} cy={py(a)} r="3" class="an-chart__pt" />
                  <text x={px(i)} y={base + 26} text-anchor="middle" class="an-chart__d">{i + 1}</text>
                </g>
              ))}
              {peaks.map(p => (
                <g>
                  <line x1={px(p.i)} x2={px(p.i)} y1={py(prof[p.i])} y2={py(p.alt)} class="an-chart__dash" />
                  <circle cx={px(p.i)} cy={py(p.alt)} r="6" class="an-chart__peak" />
                  <text x={px(p.i)} y={py(p.alt) - 30} text-anchor="middle" class="an-chart__lb">{p.l1}</text>
