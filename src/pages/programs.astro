---
import PageLayout from '../layouts/PageLayout.astro';

/* Заглушки: подставить до запуска оплаты */
/* /programs: единственная онлайн-программа, клуб «Присутствие» */
const TRIBUTE_URL = '#tribute-link';
const BOT_URL = '#bot-link';
const CONTACT_URL = 'https://t.me/Rajuna_Yakov';
const FOUNDERS_DATE = '30 ноября';
const FOUNDERS_PRICE = '2 500';
const MAIN_PRICE = '3 500';

const weeks = [
  ['Неделя 1', 'Остановка хаоса', 'Замедляемся и учимся замечать, что происходит внутри.'],
  ['Неделя 2', 'Сборка внимания', 'Возвращаем внимание из мыслей в тело и дыхание.'],
  ['Неделя 3', 'Стабилизация', 'Остаёмся в контакте с собой под нагрузкой.'],
  ['Неделя 4', 'Интеграция', 'Переносим практику в работу, отношения и решения.'],
];

const inside = [
  'Две живые практики в неделю. Пропустил, посмотришь в записи.',
  'Аудио-практика каждое утро, около 10 минут.',
  'Воскресное наставление: тема недели и ответы на вопросы.',
  'Общий чат участников.',
  'Архив всех практик.',
];

const changes = [
  'Меньше внутреннего шума и автоматических реакций.',
  'Больше ясности и устойчивости.',
  'Ближе контакт с телом и своими состояниями.',
  'Решения принимаешь спокойнее.',
  'Появляется внутренний центр, к которому можно вернуться в любую погоду.',
];

const faq = [
  ['Нужен ли опыт?', 'Нет. Практики простые, объясняю с нуля.'],
  ['Сколько времени в день?', '10–20 минут.'],
  ['Если пропущу живую практику?', 'Будет запись.'],
  ['Как оплатить?', 'Кнопкой выше, через Tribute. Доступ в закрытый канал бот выдаст сразу.'],
  ['Что будет с ценой, если я уйду и вернусь?', 'Подписка с перерывом идёт по основной цене.'],
  ['Это терапия?', 'Нет. Практики не заменяют медицинскую или психологическую помощь.'],
];
---

<PageLayout
  title="Присутствие. Возвращение в центр — The Open Sky"
  description="Закрытый клуб в Telegram. Живые практики, ежедневная опора и наставления Якова Раджуны."
>
  <div class="pr">
    <!-- 1. Первый экран -->
    <section class="pr-hero">
      <div class="pr-hero__orb" aria-hidden="true"></div>
      <div class="frame pr-hero__in">
        <span class="pr-label reveal">Закрытый клуб · Telegram</span>
        <h1 class="pr-h1 reveal d1">Присутствие<em>Возвращение в центр</em></h1>
        <p class="pr-lede reveal d2">
          Живые практики, ежедневная опора и наставления Якова Раджуны.
        </p>
        <div class="reveal d3">
          <a class="pr-btn" href={TRIBUTE_URL}>Войти в клуб. {FOUNDERS_PRICE} ₽ в месяц</a>
          <p class="pr-note">Цена основателей до {FOUNDERS_DATE}. Потом {MAIN_PRICE} ₽.</p>
        </div>
      </div>
    </section>

    <!-- 2–4. Боль, следствие, прояснение -->
    <section class="pr-sec pr-sec--paper">
      <div class="frame frame--sm">
        <h2 class="pr-h2 reveal">Ты всё успеваешь. И почти ничего не чувствуешь.</h2>
        <p class="pr-p reveal d1">
          Голова не выключается. Решения принимаешь из напряжения. Вечером устал, а выдохнуть не получается.
        </p>
        <p class="pr-p pr-p--em reveal d2">Это не слабость. Это внимание, которое давно не с тобой.</p>
      </div>
    </section>

    <section class="pr-sec pr-sec--linen">
      <div class="frame frame--sm">
        <p class="pr-p reveal">
          Реакции идут на автомате. Энергия уходит в шум. Работе и близким достаётся остаток.
        </p>
        <p class="pr-p reveal d1">Можно терпеть годами. Многие так и живут.</p>
        <h2 class="pr-h2 pr-h2--gap reveal d2">Проблема не в жизни. Проблема в состоянии.</h2>
        <p class="pr-p pr-p--em reveal d3">А состояние можно тренировать. Не знаниями. Опытом.</p>
      </div>
    </section>

    <!-- 5. Как это работает -->
    <section class="pr-sec pr-sec--sand">
      <div class="frame frame--sm">
        <span class="pr-label reveal">Как это работает</span>
        <p class="pr-p pr-p--lg reveal d1">
          Присутствие это способность оставаться в контакте с собой, телом и тем, что происходит сейчас, и не теряться в мыслях.
        </p>
        <p class="pr-p reveal d2">Клуб идёт четырёхнедельным кругом.</p>
        <ol class="pr-weeks">
          {weeks.map(([w, t, d], i) => (
            <li class={`reveal d${Math.min(i + 1, 4)}`}>
              <span class="pr-weeks__n">{w}</span>
              <span class="pr-weeks__t">{t}</span>
              <span class="pr-weeks__d">{d}</span>
            </li>
          ))}
        </ol>
        <p class="pr-p pr-p--em reveal">Потом круг начинается заново, глубже.</p>
      </div>
    </section>

    <!-- 6–7. Внутри, что меняется -->
    <section class="pr-sec pr-sec--amber">
      <div class="frame frame--sm">
        <span class="pr-label pr-label--l reveal">Что внутри</span>
        <ul class="pr-list">
          {inside.map((t, i) => <li class={`reveal d${Math.min(i + 1, 4)}`}>{t}</li>)}
        </ul>
        <span class="pr-label pr-label--l pr-label--gap reveal">Что меняется</span>
        <ul class="pr-list">
          {changes.map((t, i) => <li class={`reveal d${Math.min(i + 1, 4)}`}>{t}</li>)}
        </ul>
      </div>
    </section>

    <!-- 8. Кто ведёт -->
    <section class="pr-sec pr-sec--bronze">
      <div class="frame frame--sm">
        <span class="pr-label pr-label--l reveal">Кто ведёт</span>
        <h2 class="pr-h2 pr-h2--l reveal d1">Яков Раджуна</h2>
        <p class="pr-p pr-p--l reveal d2">
          Больше 20 лет практики внимания, дыхания и цигун. 300+ проведённых ретритов, 3 000+ человек в работе. Ведёт практики в Таиланде, России и Индии.
        </p>
        <p class="pr-p pr-p--l pr-p--em reveal d3">
          Я не обещаю новую версию тебя. Я помогаю убрать лишний шум и вернуться к себе.
        </p>
      </div>
    </section>

    <!-- 9. Сначала попробуй -->
    <section class="pr-sec pr-sec--graphite">
      <div class="frame frame--sm pr-center">
        <span class="pr-label pr-label--l reveal">Сначала попробуй</span>
        <h2 class="pr-h2 pr-h2--l reveal d1">Семь минут. Практика «Остановка хаоса».</h2>
        <div class="reveal d2">
          <a class="pr-btn pr-btn--ghost" href={BOT_URL}>Получить практику</a>
        </div>
      </div>
    </section>

    <!-- 10. Цена и вход -->
    <section class="pr-sec pr-sec--void" id="vhod">
      <div class="frame frame--sm pr-center">
        <span class="pr-label pr-label--l reveal">Цена и вход</span>
        <p class="pr-price reveal d1">{FOUNDERS_PRICE} ₽<span> в месяц</span></p>
        <p class="pr-p pr-p--l reveal d2">
          Цена основателей, если оформить подписку до {FOUNDERS_DATE}. Она закрепляется, пока подписка не прерывалась.
        </p>
        <p class="pr-p pr-p--l reveal d2">С 1 декабря: {MAIN_PRICE} ₽ в месяц.</p>
        <p class="pr-p pr-p--l pr-p--em reveal d3">Места не ограничены. Меняется только цена.</p>
        <div class="reveal d4">
          <a class="pr-btn" href={TRIBUTE_URL}>Войти в клуб</a>
          <p class="pr-note pr-note--l">Отмена в любой момент.</p>
        </div>
      </div>
    </section>

    <!-- Вопросы -->
    <section class="pr-sec pr-sec--void pr-faq">
      <div class="frame frame--sm">
        <span class="pr-label pr-label--l reveal">Вопросы</span>
        {faq.map(([q, a]) => (
          <div class="pr-faq__i reveal">
            <h3>{q}</h3>
            <p>{a}</p>
          </div>
        ))}
        <p class="pr-note pr-note--l reveal">
          Остались вопросы: <a href={CONTACT_URL}>Telegram</a>
        </p>
      </div>
    </section>
  </div>
</PageLayout>

<style>
  .pr {
    --pr-serif: var(--display);
    --pr-sans: var(--sans);
  }

  /* Тексты на русском: Fraunces и Syne без кириллицы, поэтому Source Serif 4 и Inter Tight */
  .pr-label {
    font-family: var(--pr-sans);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--honey);
    display: block;
    margin-bottom: var(--s-6);
  }
  .pr-label--l { color: rgba(232, 198, 138, 0.8); }
  .pr-label--gap { margin-top: var(--s-10); }

  .pr-hero {
    position: relative;
    overflow: hidden;
    min-height: 92svh;
    display: flex;
    align-items: center;
    background: linear-gradient(180deg, var(--bone) 0%, var(--paper) 100%);
    padding-block: var(--s-10) var(--s-9);
  }
  .pr-hero__orb {
    position: absolute;
    right: -12vw;
    top: -14vw;
    width: 62vw;
    height: 62vw;
    max-width: 760px;
    max-height: 760px;
    border-radius: 50%;
    background: var(--orb);
    opacity: 0.4;
    filter: blur(4px);
  }
  .pr-hero__in { position: relative; z-index: 1; }
  .pr-h1 {
    font-family: var(--pr-serif);
    font-weight: 400;
    font-size: clamp(48px, 9vw, 132px);
    line-height: 0.98;
    letter-spacing: -0.03em;
    color: var(--earth);
    margin-bottom: var(--s-7);
  }
  .pr-h1 em {
    display: block;
    font-style: italic;
    font-weight: 300;
    font-size: 0.42em;
    letter-spacing: -0.01em;
    color: var(--honey);
    margin-top: var(--s-4);
  }
  .pr-lede {
    font-family: var(--pr-serif);
    font-style: italic;
    font-weight: 300;
    font-size: clamp(19px, 2vw, 28px);
    line-height: 1.5;
    color: var(--fg-soft);
    max-width: 34ch;
    margin-bottom: var(--s-8);
  }

  .pr-btn {
    display: inline-block;
    font-family: var(--pr-sans);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--bone);
    background: var(--earth);
    padding: 20px 36px;
    border-radius: var(--r-pill);
    text-decoration: none;
    transition: background 0.5s ease, color 0.5s ease;
  }
  .pr-btn:hover { background: var(--ember); }
  .pr-sec--void .pr-btn, .pr-btn--ghost {
    background: transparent;
    color: #E8C68A;
    border: 1px solid rgba(232, 198, 138, 0.5);
  }
  .pr-sec--void .pr-btn:hover, .pr-btn--ghost:hover {
    background: rgba(232, 198, 138, 0.12);
    color: #F1D89C;
  }
  .pr-note {
    font-family: var(--pr-sans);
    font-size: 14px;
    color: var(--fg-mute);
    margin-top: var(--s-4);
  }
  .pr-note--l { color: rgba(250, 247, 240, 0.5); }
  .pr-note a { color: #E8C68A; }

  /* Главы: свет сверху, глубина снизу */
  .pr-sec { padding-block: clamp(96px, 16svh, 200px); }
  .pr-sec--paper { background: var(--paper); }
  .pr-sec--linen { background: var(--linen); }
  .pr-sec--sand { background: linear-gradient(180deg, var(--linen) 0%, #DCC08A 100%); }
  .pr-sec--amber { background: linear-gradient(180deg, #8E6A3E 0%, #5A4128 100%); }
  .pr-sec--bronze { background: linear-gradient(180deg, #5A4128 0%, #3A2D20 100%); }
  .pr-sec--graphite { background: linear-gradient(180deg, #3A2D20 0%, #29241D 100%); }
  .pr-sec--void { background: linear-gradient(180deg, #29241D 0%, var(--void) 100%); }

  .pr-h2 {
    font-family: var(--pr-serif);
    font-weight: 400;
    font-size: clamp(30px, 4.4vw, 62px);
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--earth);
    margin-bottom: var(--s-7);
  }
  .pr-h2--gap { margin-top: var(--s-9); }
  .pr-h2--l { color: #F3EBDA; }

  .pr-p {
    font-family: var(--pr-sans);
    font-weight: 300;
    font-size: clamp(17px, 1.5vw, 20px);
    line-height: 1.85;
    color: var(--fg-soft);
    margin-bottom: var(--s-5);
    max-width: 52ch;
  }
  .pr-p--lg {
    font-family: var(--pr-serif);
    font-size: clamp(22px, 2.4vw, 34px);
    line-height: 1.35;
    color: var(--earth);
    margin-bottom: var(--s-7);
  }
  .pr-p--em {
    font-family: var(--pr-serif);
    font-style: italic;
    font-size: clamp(20px, 2vw, 28px);
    line-height: 1.5;
    color: var(--ember);
  }
  .pr-p--l { color: rgba(250, 247, 240, 0.82); }
  .pr-p--l.pr-p--em { color: #E8C68A; }

  .pr-weeks {
    list-style: none;
    margin: var(--s-8) 0;
    padding: 0;
    border-top: 1px solid var(--rule);
  }
  .pr-weeks li {
    display: grid;
    grid-template-columns: 110px 1fr;
    gap: var(--s-1) var(--s-5);
    padding: var(--s-6) 0;
    border-bottom: 1px solid var(--rule);
  }
  .pr-weeks__n {
    grid-row: span 2;
    font-family: var(--pr-sans);
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ember);
    padding-top: 8px;
  }
  .pr-weeks__t {
    font-family: var(--pr-serif);
    font-size: clamp(22px, 2.4vw, 32px);
    color: var(--earth);
  }
  .pr-weeks__d {
    font-family: var(--pr-sans);
    font-weight: 300;
    font-size: 16px;
    line-height: 1.7;
    color: var(--fg-soft);
  }

  .pr-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .pr-list li {
    font-family: var(--pr-serif);
    font-size: clamp(20px, 2.2vw, 30px);
    line-height: 1.35;
    color: #F3EBDA;
    padding: var(--s-5) 0;
    border-bottom: 1px solid var(--rule-d);
  }

  .pr-center { text-align: left; }
  .pr-price {
    font-family: var(--pr-serif);
    font-weight: 300;
    font-size: clamp(64px, 11vw, 150px);
    line-height: 1;
    letter-spacing: -0.03em;
    color: #F1D89C;
    margin-bottom: var(--s-6);
  }
  .pr-price span {
    font-size: 0.22em;
    letter-spacing: 0;
    color: rgba(250, 247, 240, 0.6);
    margin-left: 0.4em;
  }
  .pr-center .pr-btn { margin-top: var(--s-6); }

  .pr-faq { padding-top: 0; }
  .pr-faq__i {
    padding: var(--s-6) 0;
    border-bottom: 1px solid var(--rule-d);
  }
  .pr-faq__i h3 {
    font-family: var(--pr-serif);
    font-weight: 400;
    font-size: clamp(20px, 2vw, 26px);
    color: #F3EBDA;
    margin-bottom: var(--s-3);
  }
  .pr-faq__i p {
    font-family: var(--pr-sans);
    font-weight: 300;
    font-size: 16px;
    line-height: 1.75;
    color: rgba(250, 247, 240, 0.7);
  }
  .pr-faq .pr-note { margin-top: var(--s-7); }

  @media (max-width: 640px) {
    .pr-weeks li { grid-template-columns: 1fr; }
    .pr-weeks__n { grid-row: auto; padding-top: 0; }
    .pr-btn { padding: 18px 28px; font-size: 12px; }
  }
</style>
