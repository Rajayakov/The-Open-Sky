---
/* /programs — the single online program: Присутствие — Возвращение в центр
   Structure-only first version: 13 sections, exact headings, development
   placeholders instead of copy. Replace the `placeholder` strings (and the
   [Placeholder] values in the details list) when the copywriting stage begins.
   Hero and final CTA reuse PageHero / CTASection. */
import PageLayout from '../layouts/PageLayout.astro';
import PageHero from '../components/PageHero.astro';
import CTASection from '../components/CTASection.astro';
import { getProgram } from '../data/programs';

const program = getProgram('presence')!;
const placeholder = '[Placeholder — section copy]';

const weeks = [
  { n: '1', title: 'Неделя 1 — Остановка хаоса' },
  { n: '2', title: 'Неделя 2 — Сборка внимания' },
  { n: '3', title: 'Неделя 3 — Стабилизация состояния' },
  { n: '4', title: 'Неделя 4 — Интеграция в жизнь' },
];

/* Facts taken from the program metadata (4 weeks · 2 × 90 min · chat). */
const support = [
  { label: 'Продолжительность', value: '4 недели' },
  { label: 'Встречи', value: '2 в неделю · 90 минут' },
  { label: 'Поддержка', value: 'чат' },
];
const details = [
  { label: 'Формат', value: 'Онлайн · 2 встречи в неделю по 90 минут · чат' },
  { label: 'Продолжительность', value: '4 недели' },
  { label: 'Дата старта', value: '[Placeholder — to be announced]' },
  { label: 'Стоимость', value: '[Placeholder — to be announced]' },
];
const faq = [1, 2, 3].map((n) => ({ q: `[Placeholder — question ${n}]`, a: placeholder }));
---

<PageLayout
  title="Присутствие — Возвращение в центр — The Open Sky"
  description={program.description}
>
  <div lang="ru" class="presence">

    <!-- 1. HERO -->
    <PageHero
      label="Online Program"
      title="Присутствие — "
      titleEm="Возвращение в центр"
      theme="program"
    />

    <!-- 2. PROBLEM -->
    <section class="pr-section pr-section--a section frame" aria-labelledby="pr-problem">
      <h2 id="pr-problem" class="pr-h2 reveal">Когда ты постоянно находишься у себя в голове</h2>
      <p class="pr-ph t-body reveal d1">{placeholder}</p>
    </section>

    <!-- 3. PROGRAM GOAL -->
    <section class="pr-section pr-section--b section" aria-labelledby="pr-goal">
      <div class="frame">
        <h2 id="pr-goal" class="pr-h2 reveal">От внутреннего хаоса — к ясности и опоре</h2>
        <p class="pr-ph t-body reveal d1">{placeholder}</p>
      </div>
    </section>

    <!-- 4. APPROACH -->
    <section class="pr-section pr-section--a section frame" aria-labelledby="pr-approach">
      <h2 id="pr-approach" class="pr-h2 reveal">Меньше техник. Больше присутствия.</h2>
      <p class="pr-ph t-body reveal d1">{placeholder}</p>
    </section>

    <!-- 5. FOUR-WEEK JOURNEY -->
    <section class="pr-section pr-section--b section" aria-labelledby="pr-journey">
      <div class="frame">
        <h2 id="pr-journey" class="pr-h2 reveal">Четыре недели возвращения к себе</h2>
        <ol class="pr-weeks">
          {weeks.map((w, i) => (
            <li class={`pr-week reveal d${(i % 3) + 1}`}>
              <span class="t-label pr-week__num" aria-hidden="true">{w.n}</span>
              <h3 class="pr-h3">{w.title}</h3>
              <p class="pr-ph t-body">{placeholder}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- 6. PRACTICES -->
    <section class="pr-section pr-section--a section frame" aria-labelledby="pr-practices">
      <h2 id="pr-practices" class="pr-h2 reveal">Простые инструменты для работы с вниманием</h2>
      <p class="pr-ph t-body reveal d1">{placeholder}</p>
    </section>

    <!-- 7. FORMAT AND SUPPORT -->
    <section class="pr-section pr-section--b section" aria-labelledby="pr-format">
      <div class="frame">
        <h2 id="pr-format" class="pr-h2 reveal">Четыре недели практики с поддержкой</h2>
        <dl class="pr-facts reveal d1">
          {support.map((f) => (
            <div class="pr-facts__row">
              <dt class="t-label">{f.label}</dt>
              <dd>{f.value}</dd>
            </div>
          ))}
        </dl>
        <p class="pr-ph t-body reveal d2">{placeholder}</p>
      </div>
    </section>

    <!-- 8. OUTCOMES -->
    <section class="pr-section pr-section--a section frame" aria-labelledby="pr-outcomes">
      <h2 id="pr-outcomes" class="pr-h2 reveal">Что ты сможешь изменить в своей повседневной жизни</h2>
      <p class="pr-ph t-body reveal d1">{placeholder}</p>
    </section>

    <!-- 9. ABOUT THE GUIDE — existing biography and portrait from /about -->
    <section class="pr-section pr-section--b section" aria-labelledby="pr-guide">
      <div class="frame pr-guide">
        <img
          class="pr-guide__img reveal"
          src="/images/portrait/yakov-flags.jpg"
          alt="Яков Раджуна"
          loading="lazy"
          decoding="async"
        />
        <div>
          <h2 id="pr-guide" class="pr-h2 reveal">Яков Раджуна — путь присутствия и осознанности</h2>
          <p class="t-body pr-guide__bio reveal d1" lang="en">
            Yakov Rajuna has been leading groups in difficult terrain since 2010. He started as a trekking guide in the Caucasus, then spent years studying facilitation, ceremony, and group dynamics. The combination became his own — something that doesn't have a precise name, but that people who have experienced it recognise immediately.
          </p>
          <a href="/about" class="btn-text reveal d2">About Yakov</a>
        </div>
      </div>
    </section>

    <!-- 10. WHO THE PROGRAM IS FOR -->
    <section class="pr-section pr-section--a section frame" aria-labelledby="pr-for">
      <h2 id="pr-for" class="pr-h2 reveal">Для тех, кто готов вернуться к осознанной жизни</h2>
      <p class="pr-ph t-body reveal d1">{placeholder}</p>
    </section>

    <!-- 11. FAQ -->
    <section class="pr-section pr-section--b section" aria-labelledby="pr-faq">
      <div class="frame">
        <h2 id="pr-faq" class="pr-h2 reveal">Что важно знать перед началом</h2>
        <div class="pr-faq reveal d1">
          {faq.map((item) => (
            <details class="pr-faq__item">
              <summary class="pr-faq__q">{item.q}</summary>
              <p class="pr-ph t-body">{item.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- 12. PARTICIPATION DETAILS -->
    <section class="pr-section pr-section--a section frame" aria-labelledby="pr-details">
      <h2 id="pr-details" class="pr-h2 reveal">Формат, продолжительность и стоимость</h2>
      <dl class="pr-facts reveal d1">
        {details.map((f) => (
          <div class="pr-facts__row">
            <dt class="t-label">{f.label}</dt>
            <dd>{f.value}</dd>
          </div>
        ))}
      </dl>
    </section>

    <!-- 13. FINAL CTA -->
    <CTASection
      label="Online Program"
      title="Начни возвращаться в центр."
      primaryHref="/connect"
      primarySource="program_presence_cta"
      primaryLabel="[CTA — placeholder]"
    />

  </div>
</PageLayout>

<style>
  .presence { background: var(--pg-prg-bg); }

  .pr-section--a { background: var(--pg-prg-bg); }
  .pr-section--b { background: var(--pg-prg-bg-alt); }

  .pr-h2 {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(28px, 3.6vw, 48px);
    line-height: 1.12;
    letter-spacing: -0.015em;
    color: var(--pg-prg-fg);
    margin: 0;
    max-width: 24ch;
    text-wrap: balance;
  }
  .pr-h3 {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(18px, 1.8vw, 22px);
    line-height: 1.25;
    color: var(--pg-prg-fg);
    margin: 0;
  }
  .pr-ph {
    margin: var(--s-6) 0 0;
    color: var(--pg-prg-mute);
    font-style: italic;
  }

  /* Four weeks — one connected sequence */
  .pr-weeks {
    list-style: none;
    margin: var(--s-7) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border: 1px solid rgba(28,26,22,0.10);
    border-radius: var(--r-2);
    overflow: hidden;
  }
  .pr-week {
    padding: var(--s-6);
    background: var(--pg-prg-bg);
    border-right: 1px solid rgba(28,26,22,0.10);
  }
  .pr-week:last-child { border-right: none; }
  .pr-week__num { color: var(--honey); display: block; margin-bottom: var(--s-3); }
  .pr-week .pr-ph { margin-top: var(--s-4); }

  /* Facts list (format & support / participation details) */
  .pr-facts {
    margin: var(--s-7) 0 0;
    max-width: 640px;
    border-top: 1px solid rgba(28,26,22,0.10);
  }
  .pr-facts__row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--s-4);
    padding: var(--s-4) 0;
    border-bottom: 1px solid rgba(28,26,22,0.07);
  }
  .pr-facts dd {
    margin: 0;
    font-family: var(--serif);
    font-style: italic;
    font-size: 15px;
    color: var(--pg-prg-fg);
    text-align: right;
  }

  /* Guide */
  .pr-guide {
    display: grid;
    grid-template-columns: minmax(200px, 320px) 1fr;
    gap: clamp(32px, 6vw, 80px);
    align-items: start;
  }
  .pr-guide__img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--r-2);
  }
  .pr-guide__bio { margin: var(--s-6) 0 var(--s-5); max-width: 52ch; }

  /* FAQ */
  .pr-faq { margin-top: var(--s-7); max-width: 720px; border-top: 1px solid rgba(28,26,22,0.10); }
  .pr-faq__item { border-bottom: 1px solid rgba(28,26,22,0.07); padding: var(--s-4) 0; }
  .pr-faq__q { cursor: pointer; font-family: var(--serif); font-size: 18px; color: var(--pg-prg-fg); }
  .pr-faq__q:focus-visible { outline: 2px solid var(--honey); outline-offset: 4px; }

  @media (max-width: 900px) {
    .pr-weeks { grid-template-columns: 1fr 1fr; }
    .pr-week:nth-child(2) { border-right: none; }
    .pr-week:nth-child(-n+2) { border-bottom: 1px solid rgba(28,26,22,0.10); }
  }
  @media (max-width: 600px) {
    .pr-weeks { grid-template-columns: 1fr; }
    .pr-week { border-right: none; border-bottom: 1px solid rgba(28,26,22,0.10); }
    .pr-week:last-child { border-bottom: none; }
    .pr-guide { grid-template-columns: 1fr; }
    .pr-guide__img { max-width: 320px; }
    .pr-facts__row { flex-direction: column; gap: var(--s-2); }
    .pr-facts dd { text-align: left; }
  }
</style>
