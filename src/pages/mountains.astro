---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

const upcoming = [
  {
    slug: 'kailash-2026',
    name: 'Kailash',
    tagline: 'The Abode of Shiva',
    terrain: 'Tibet',
    date: 'September 20, 2027',
    sortDate: '2027-09-20',
    duration: '10 days',
    groupSize: 'Up to 15 people',
    status: 'open' as const,
    heroImage: '/images/mountains/kailash-featured.jpg',
  },
  {
    slug: 'arunachala-2026',
    name: 'Arunachala',
    tagline: 'The Sacred Fire',
    terrain: 'India',
    date: 'November 2027',
    sortDate: '2027-11-01',
    duration: '7 days',
    groupSize: 'Up to 15 people',
    status: 'open' as const,
    heroImage: '/images/mountains/arunachala-featured.jpg',
  },
  {
    slug: 'annapurna-2027',
    name: 'Annapurna',
    tagline: 'The Living Mountain',
    terrain: 'Nepal',
    date: 'March 28, 2027',
    sortDate: '2027-03-28',
    duration: '14–20 days',
    groupSize: 'Up to 15 people',
    status: 'open' as const,
    heroImage: '/images/mountains/annapurna-hero.jpg',
  },
];

const past = [
  {
    name: 'Mardi Himal',
    terrain: 'Nepal',
    year: '2025',
    participants: '12 participants',
    image: '/images/mountains/card-3.jpg',
  },
  {
    name: 'Himalayas',
    terrain: 'India',
    year: '2024',
    participants: null as string | null,
    image: '/images/mountains/card-4.jpg',
  },
];

const testimonials = [
  {
    quote: 'I returned quieter. More certain of what matters. The mountain doesn\'t explain itself — and neither does the change.',
    name: 'Elena K.',
    location: 'Moscow',
    journey: 'Mardi Himal 2025',
  },
  {
    quote: 'Yakov holds the space without filling it. That quality is rare. The mountains do the work — he ensures you can receive it.',
    name: 'David M.',
    location: 'Berlin',
    journey: 'Georgian Highlands 2024',
  },
  {
    quote: 'Not transformed in any dramatic way — clarified. Like something blurry for years finally came into focus.',
    name: 'Maria T.',
    location: 'Tbilisi',
    journey: 'Pontic Alps 2024',
  },
];

upcoming.sort((a, b) => a.sortDate.localeCompare(b.sortDate));
const today = new Date().toISOString().slice(0, 10);
const openJourney = upcoming.find((j) => j.status === 'open' && j.sortDate >= today)
  ?? upcoming.find((j) => j.status === 'open')
  ?? null;
---

<Base
  title="Sacred Mountain Journeys — The Open Sky"
  description="Small-group pilgrimages into the world's sacred mountain landscapes. Kailash, Annapurna and Arunachala with Yakov Rajuna."
>
  <Nav />
  <main class="mountains-page">
    <section class="mountain-hero" aria-label="Sacred mountain journeys">
      <img class="mountain-hero__image" src="/images/mountains/hero.jpg" alt="Himalayan mountain range at first light" fetchpriority="high" loading="eager" decoding="async" />
      <div class="mountain-hero__veil" aria-hidden="true"></div>
      <div class="mountain-hero__content frame">
        <div class="mountain-hero__copy">
          <p class="eyebrow eyebrow--light reveal">THE OPEN SKY · PILGRIMAGE JOURNEYS</p>
          <h1 class="mountain-hero__title reveal d1">The mountain<br /><span>changes the view.</span></h1>
          <p class="mountain-hero__description reveal d2">Journeys into sacred landscapes. Beyond the familiar, closer to what is essential.</p>
          <a class="mountain-link mountain-link--light reveal d3" href="#journeys">Explore the journeys <span aria-hidden="true">↘</span></a>
        </div>
        <div class="mountain-hero__signature reveal d3">
          <span class="mountain-hero__line"></span>
          <span>Led personally by Yakov Rajuna</span>
        </div>
      </div>
      <div class="mountain-hero__bottom" aria-hidden="true">
        <span>HIMALAYAS · TIBET · SOUTH INDIA</span>
        <span>01 — THE CALL</span>
      </div>
    </section>

    <section class="mountain-intro section">
      <div class="frame mountain-intro__grid">
        <div class="mountain-intro__index reveal">
          <span class="eyebrow">A DIFFERENT KIND OF JOURNEY</span>
          <span class="mountain-intro__number">01 / 04</span>
        </div>
        <h2 class="mountain-intro__title reveal d1">Not a race to the summit.<br /><span>A return to what matters.</span></h2>
        <div class="mountain-intro__body reveal d2">
          <p>These journeys are not built around collecting destinations. They are an encounter with places that have shaped the inner life of humanity for centuries.</p>
          <p>Walking through demanding terrain changes the rhythm. The noise falls away. Attention returns to the body, the breath, the landscape — and the person moving through it.</p>
        </div>
      </div>
    </section>

    {openJourney && (
      <section class="mountain-feature" aria-label="Featured expedition">
        <div class="mountain-feature__image-wrap">
          <img src={openJourney.heroImage} alt={openJourney.name} loading="lazy" decoding="async" />
          <div class="mountain-feature__image-shade" aria-hidden="true"></div>
        </div>
        <div class="frame mountain-feature__inner">
          <div class="mountain-feature__content reveal">
            <p class="eyebrow eyebrow--light">THE NEXT DEPARTURE · {openJourney.terrain.toUpperCase()}</p>
            <h2>{openJourney.name}</h2>
            <p class="mountain-feature__tagline">{openJourney.tagline}</p>
            <div class="mountain-feature__details">
              <span>{openJourney.date}</span>
              <span>{openJourney.duration}</span>
              <span>{openJourney.groupSize}</span>
            </div>
            <div class="mountain-feature__actions">
              <a class="mountain-button mountain-button--gold" href={`/mountains/${openJourney.slug}`}>Discover the journey</a>
              <a class="mountain-button mountain-button--outline" href={`/connect?source=mountains_feature_${openJourney.slug}`}>Enquire</a>
            </div>
          </div>
          <span class="mountain-feature__caption">A journey is not measured only in distance.</span>
        </div>
      </section>
    )}

    <section class="mountain-journeys section" id="journeys" aria-label="Upcoming journeys">
      <div class="frame">
        <div class="section-heading">
          <div>
            <p class="eyebrow reveal">THE JOURNEYS AHEAD</p>
            <h2 class="section-heading__title reveal d1">Choose your horizon.</h2>
          </div>
          <p class="section-heading__note reveal d2">Small groups. Thoughtful preparation.<br />Every journey led personally.</p>
        </div>
        <div class="journey-list">
          {upcoming.map((journey, index) => (
            <article class="journey-card reveal" style={`--card-index:${index};`}>
              <a class="journey-card__image" href={`/mountains/${journey.slug}`} aria-label={`Explore ${journey.name}`}>
                <img src={journey.heroImage} alt={journey.name} loading="lazy" decoding="async" />
                <span class="journey-card__number">0{index + 1}</span>
                <span class="journey-card__open"><i></i> Applications open</span>
              </a>
              <div class="journey-card__body">
                <div class="journey-card__topline"><span>{journey.terrain}</span><span>{journey.duration}</span></div>
                <h3>{journey.name}</h3>
                <p class="journey-card__tagline">{journey.tagline}</p>
                <div class="journey-card__bottom">
                  <span>{journey.date}</span>
                  <a href={`/mountains/${journey.slug}`}>Explore <span aria-hidden="true">↗</span></a>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="mountain-principles section">
      <div class="frame mountain-principles__grid">
        <div class="mountain-principles__heading">
          <p class="eyebrow eyebrow--gold reveal">THE WAY WE TRAVEL</p>
          <h2 class="reveal d1">Presence over performance.</h2>
        </div>
        <div class="principle-list">
          <article class="principle reveal d1">
            <span>01</span>
            <div><h3>Small by design</h3><p>Groups are intentionally limited. Space for individual attention, a steady rhythm and genuine connection.</p></div>
          </article>
          <article class="principle reveal d2">
            <span>02</span>
            <div><h3>Led, not outsourced</h3><p>Yakov is present throughout the journey — from preparation and the route itself to the closing circle.</p></div>
          </article>
          <article class="principle reveal d3">
            <span>03</span>
            <div><h3>Respect for the terrain</h3><p>Preparation, acclimatisation and the realities of the landscape come before ambition or schedule.</p></div>
          </article>
        </div>
      </div>
    </section>

    <section class="mountain-guide section" aria-label="Your guide">
      <div class="frame mountain-guide__grid">
        <div class="mountain-guide__portrait reveal">
          <img src="/images/portrait/yakov-flags.jpg" alt="Yakov Rajuna in the mountains" loading="lazy" decoding="async" />
          <span class="mountain-guide__portrait-caption">YAKOV RAJUNA · EXPEDITION LEADER</span>
        </div>
        <div class="mountain-guide__content">
          <p class="eyebrow eyebrow--gold reveal">THE PERSON BEHIND THE JOURNEY</p>
          <h2 class="mountain-guide__title reveal d1">Yakov Rajuna</h2>
          <div class="mountain-guide__stats reveal d2">
            <div><strong>20+</strong><span>Years of practice</span></div>
            <div><strong>350+</strong><span>Ceremonies led</span></div>
            <div><strong>3,500+</strong><span>People guided</span></div>
          </div>
          <p class="mountain-guide__bio reveal d3">For over two decades, Yakov has guided people through inner work and journeys across sacred landscapes in Asia, the Caucasus and beyond. His path includes initiations in Peru and Brazil. Each mountain expedition is small, intentional and led personally.</p>
          <a href="/about" class="mountain-link reveal d4">More about Yakov <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </section>

    <section class="mountain-voices section" aria-label="Participant voices">
      <div class="frame">
        <div class="section-heading section-heading--voices">
          <div><p class="eyebrow eyebrow--gold reveal">WORDS FROM THE JOURNEY</p><h2 class="section-heading__title reveal d1">What stays with you.</h2></div>
          <span class="mountain-voices__mark" aria-hidden="true">“</span>
        </div>
        <div class="voice-grid">
          {testimonials.map((t, i) => (
            <figure class="voice reveal" style={`--card-index:${i};`}>
              <blockquote>{t.quote}</blockquote>
              <figcaption><strong>{t.name}</strong><span>{t.location} · {t.journey}</span></figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <section class="mountain-past section" aria-label="Past expeditions">
      <div class="frame">
        <div class="mountain-past__heading reveal">
          <p class="eyebrow">TRACES OF THE PATH</p>
          <h2 class="section-heading__title">Journeys already lived.</h2>
        </div>
        <div class="past-grid">
          {past.map((item, index) => (
            <a class="past-card reveal" href={`/connect?source=mountains_hub_past_${index + 1}`}>
              <img src={item.image} alt={item.name} loading="lazy" decoding="async" />
              <span class="past-card__shade"></span>
              <span class="past-card__meta">{item.terrain} · {item.year}</span>
              <span class="past-card__title">{item.name}</span>
              <span class="past-card__link">Photos &amp; stories ↗</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="mountain-final">
      <img src="/images/mountains/hero-5.jpg" alt="" aria-hidden="true" loading="lazy" decoding="async" />
      <div class="mountain-final__overlay" aria-hidden="true"></div>
      <div class="frame mountain-final__content">
        <p class="eyebrow eyebrow--light reveal">THE FIRST STEP IS A CONVERSATION</p>
        <h2 class="reveal d1">Some journeys<br /><span>begin long before departure.</span></h2>
        <p class="mountain-final__text reveal d2">Tell us what is calling you. We will talk through the route, preparation and whether the journey is right for you.</p>
        <div class="mountain-final__actions reveal d3">
          {openJourney && <a class="mountain-button mountain-button--gold" href={`/mountains/${openJourney.slug}`}>Explore the next journey</a>}
          <a class="mountain-button mountain-button--outline" href="/connect?source=mountains_hub_footer">Write to Yakov</a>
        </div>
        <span class="mountain-final__signature">THE OPEN SKY · BY YAKOV RAJUNA</span>
      </div>
    </section>
  </main>
  <Footer />
</Base>

<style>
  .mountains-page {
    --ivory: #f2eee5;
    --paper: #e9e1d3;
    --paper-deep: #ded2bf;
    --ink: #28251f;
    --muted: #777064;
    --gold: #ad8750;
    --gold-dark: #88663c;
    --bronze: #6f5135;
    --line: rgba(75, 61, 43, .16);
    --serif: var(--display, 'Fraunces', Georgia, serif);
    --sans: var(--sans, 'DM Sans', Arial, sans-serif);
    background: var(--ivory);
    color: var(--ink);
    overflow: hidden;
  }
  .mountains-page * { box-sizing: border-box; }
  .mountains-page a { text-decoration: none; }
  .eyebrow {
    margin: 0;
    color: rgba(75, 65, 50, .62);
    font: 600 9px/1.4 var(--sans);
    letter-spacing: .24em;
    text-transform: uppercase;
  }
  .eyebrow--light { color: rgba(255, 248, 235, .76); }
  .eyebrow--gold { color: var(--gold-dark); }
  .mountain-hero {
    min-height: min(900px, 100svh);
    min-height: max(720px, 100svh);
    position: relative;
    display: flex;
    align-items: center;
    overflow: hidden;
    color: #fff8ec;
    background: #5d584b;
  }
  .mountain-hero__image, .mountain-final > img {
    position: absolute; inset: 0; width: 100%; height: 100%;
    object-fit: cover; object-position: center 45%;
  }
  .mountain-hero__veil {
    position: absolute; inset: 0;
    background:
      linear-gradient(90deg, rgba(28,25,20,.58) 0%, rgba(34,29,22,.30) 48%, rgba(34,29,22,.06) 100%),
      linear-gradient(0deg, rgba(28,24,19,.40) 0%, transparent 42%, rgba(28,24,19,.10) 100%);
  }
  .mountain-hero__content {
    position: relative; z-index: 1;
    display: flex; flex-direction: column; justify-content: center;
    min-height: inherit; padding-top: 110px; padding-bottom: 120px;
  }
  .mountain-hero__copy { max-width: 820px; }
  .mountain-hero__title {
    margin: 30px 0 28px;
    max-width: 900px;
    color: #fff8ed;
    font: 400 clamp(64px, 9.4vw, 138px)/.94 var(--serif);
    letter-spacing: -.055em;
  }
  .mountain-hero__title span { color: #e5c797; }
  .mountain-hero__description {
    max-width: 430px; margin: 0;
    color: rgba(255,248,235,.84);
    font: 400 clamp(15px,1.4vw,18px)/1.8 var(--sans);
  }
  .mountain-link {
    display: inline-flex; align-items: center; gap: 22px;
    color: var(--bronze); padding: 0 0 10px;
    border-bottom: 1px solid rgba(111,81,53,.45);
    font: 600 10px/1.4 var(--sans); letter-spacing: .17em; text-transform: uppercase;
    transition: gap .3s ease, color .3s ease;
  }
  .mountain-link:hover { gap: 30px; color: var(--gold-dark); }
  .mountain-link--light { margin-top: 38px; color: #fff4df; border-color: rgba(255,244,223,.55); }
  .mountain-link--light:hover { color: #e5c797; }
  .mountain-hero__signature {
    position: absolute; right: 32px; bottom: 76px;
    display: flex; align-items: center; gap: 14px;
    color: rgba(255,248,235,.75);
    font: 500 9px/1.4 var(--sans); letter-spacing: .18em; text-transform: uppercase;
  }
  .mountain-hero__line { width: 42px; height: 1px; background: #d6b77f; }
  .mountain-hero__bottom {
    position: absolute; z-index: 2; left: max(32px, calc((100vw - 1240px)/2)); right: max(32px, calc((100vw - 1240px)/2)); bottom: 24px;
    display: flex; justify-content: space-between; gap: 20px;
    color: rgba(255,248,235,.54); font: 500 8px/1.4 var(--sans); letter-spacing: .2em;
  }
  .section { padding-block: clamp(88px, 11vw, 160px); }
  .mountain-intro { background: var(--ivory); }
  .mountain-intro__grid { display: grid; grid-template-columns: 1fr 2fr; column-gap: 8%; row-gap: 42px; }
  .mountain-intro__index { display: flex; flex-direction: column; justify-content: space-between; align-items: flex-start; min-height: 80px; }
  .mountain-intro__number { color: rgba(111,81,53,.48); font: 500 9px var(--sans); letter-spacing: .2em; }
  .mountain-intro__title {
    margin: 0; max-width: 900px;
    color: var(--ink); font: 400 clamp(36px,5.2vw,72px)/1.08 var(--serif); letter-spacing: -.04em;
  }
  .mountain-intro__title span { color: var(--gold-dark); }
  .mountain-intro__body {
    grid-column: 2; display: grid; grid-template-columns: 1fr 1fr; gap: 36px;
    max-width: 850px; border-top: 1px solid var(--line); padding-top: 25px;
  }
  .mountain-intro__body p { margin: 0; color: var(--muted); font: 400 14px/1.9 var(--sans); }
  .mountain-feature { min-height: 720px; position: relative; display: flex; align-items: center; overflow: hidden; background: #4e4436; color: #fff8ed; }
  .mountain-feature__image-wrap { position: absolute; inset: 0; }
  .mountain-feature__image-wrap img { width: 100%; height: 100%; object-fit: cover; object-position: center 45%; }
  .mountain-feature__image-shade { position: absolute; inset: 0; background: linear-gradient(90deg, rgba(24,21,17,.76), rgba(24,21,17,.26) 70%, rgba(24,21,17,.08)), linear-gradient(0deg, rgba(24,21,17,.40), transparent 45%); }
  .mountain-feature__inner { position: relative; z-index: 1; display: flex; align-items: center; justify-content: space-between; gap: 40px; min-height: 720px; padding-block: 90px; }
  .mountain-feature__content { max-width: 650px; }
  .mountain-feature h2 { margin: 24px 0 0; color: #fff8ed; font: 400 clamp(64px,9vw,124px)/.95 var(--serif); letter-spacing: -.05em; }
  .mountain-feature__tagline { margin: 14px 0 34px; color: #e5c797; font: 400 21px/1.4 var(--serif); }
  .mountain-feature__details { display: flex; flex-wrap: wrap; gap: 12px 26px; color: rgba(255,248,235,.75); font: 500 9px/1.5 var(--sans); letter-spacing: .13em; text-transform: uppercase; }
  .mountain-feature__actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 36px; }
  .mountain-button {
    display: inline-flex; justify-content: center; align-items: center; min-height: 48px; padding: 0 24px;
    border: 1px solid transparent; border-radius: 2px;
    font: 600 9px/1.3 var(--sans); letter-spacing: .16em; text-transform: uppercase;
    transition: background .25s ease, border-color .25s ease, color .25s ease, transform .25s ease;
  }
  .mountain-button:hover { transform: translateY(-2px); }
  .mountain-button--gold { color: #2c261c; background: #d8b77d; border-color: #d8b77d; }
  .mountain-button--gold:hover { background: #e7c991; border-color: #e7c991; }
  .mountain-button--outline { color: #fff8ed; border-color: rgba(255,248,237,.52); background: rgba(255,248,237,.06); }
  .mountain-button--outline:hover { background: rgba(255,248,237,.16); border-color: rgba(255,248,237,.85); }
  .mountain-feature__caption { align-self: flex-end; max-width: 180px; color: rgba(255,248,235,.62); font: 400 13px/1.6 var(--serif); }
  .mountain-journeys { background: var(--paper); }
  .section-heading { display: flex; justify-content: space-between; align-items: flex-end; gap: 30px; margin-bottom: 54px; }
  .section-heading__title { margin: 18px 0 0; color: var(--ink); font: 400 clamp(38px,5.2vw,72px)/1.05 var(--serif); letter-spacing: -.045em; }
  .section-heading__note { margin: 0 0 4px; color: var(--muted); font: 400 12px/1.8 var(--sans); }
  .journey-list { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 22px; }
  .journey-card { min-width: 0; background: var(--ivory); }
  .journey-card__image { position: relative; display: block; height: clamp(230px,27vw,390px); overflow: hidden; background: #a69a82; }
  .journey-card__image::after { content: ''; position: absolute; inset: 0; background: linear-gradient(0deg, rgba(24,21,17,.48), transparent 48%); }
  .journey-card__image img { width: 100%; height: 100%; object-fit: cover; transition: transform .8s cubic-bezier(.2,.65,.25,1); }
  .journey-card:hover .journey-card__image img { transform: scale(1.045); }
  .journey-card__number { position: absolute; z-index: 1; top: 18px; left: 18px; color: rgba(255,248,235,.78); font: 500 9px var(--sans); letter-spacing: .16em; }
  .journey-card__open { position: absolute; z-index: 1; left: 18px; bottom: 17px; display: flex; align-items: center; gap: 8px; color: #fff8ed; font: 500 8px var(--sans); letter-spacing: .14em; text-transform: uppercase; }
  .journey-card__open i { width: 5px; height: 5px; border-radius: 50%; background: #d6b77f; }
  .journey-card__body { padding: 25px 25px 22px; }
  .journey-card__topline { display: flex; justify-content: space-between; gap: 12px; color: var(--gold-dark); font: 600 8px var(--sans); letter-spacing: .16em; text-transform: uppercase; }
  .journey-card h3 { margin: 19px 0 2px; color: var(--ink); font: 400 clamp(28px,3vw,42px)/1.05 var(--serif); letter-spacing: -.035em; }
  .journey-card__tagline { margin: 0; color: var(--muted); font: 400 14px/1.5 var(--serif); }
  .journey-card__bottom { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-top: 28px; padding-top: 17px; border-top: 1px solid var(--line); color: var(--muted); font: 500 9px var(--sans); letter-spacing: .1em; text-transform: uppercase; }
  .journey-card__bottom a { color: var(--gold-dark); font-weight: 700; white-space: nowrap; }
  .journey-card__bottom a span { margin-left: 5px; }
  .mountain-principles { background: var(--ivory); }
  .mountain-principles__grid { display: grid; grid-template-columns: .9fr 1.1fr; gap: 10%; }
  .mountain-principles__heading h2 { max-width: 470px; margin: 22px 0 0; color: var(--ink); font: 400 clamp(42px,5.4vw,76px)/1.04 var(--serif); letter-spacing: -.045em; }
  .principle-list { border-top: 1px solid var(--line); }
  .principle { display: grid; grid-template-columns: 42px 1fr; gap: 20px; padding: 26px 0; border-bottom: 1px solid var(--line); }
  .principle > span { padding-top: 5px; color: var(--gold-dark); font: 500 9px var(--sans); letter-spacing: .12em; }
  .principle h3 { margin: 0 0 8px; color: var(--ink); font: 400 24px/1.2 var(--serif); }
  .principle p { max-width: 520px; margin: 0; color: var(--muted); font: 400 13px/1.8 var(--sans); }
  .mountain-guide { background: var(--paper); }
  .mountain-guide__grid { display: grid; grid-template-columns: .85fr 1fr; align-items: center; gap: clamp(50px,9vw,130px); }
  .mountain-guide__portrait { position: relative; max-width: 520px; }
