---
import PageLayout from '../layouts/PageLayout.astro';
import LeadForm from './LeadForm.astro';
import materials from '../data/materials.json';

export interface Props { lang: 'ru' | 'en'; slug: string; }
const { lang, slug } = Astro.props;
const m = materials.materials.find((x) => x.slug === slug)!;
const copy = {
  ru: {
    eyebrow: 'THE OPEN SKY · ПЕРВОЕ ПРИКОСНОВЕНИЕ',
    title: 'Путь <em>к Себе</em>',
    lead: 'Пространство для тишины, ясности и возвращения к главному.',
    body: 'Я собрал этот материал, чтобы поделиться практиками, которые помогают замедлиться, вернуться в присутствие и восстановить контакт с собой. Без спешки. В своём ритме.',
    note: 'Небольшой шаг. Иногда именно с него начинается путь.',
    formLabel: 'ТВОЙ МАТЕРИАЛ',
    privacy: 'Твои данные останутся конфиденциальными. Никакого шума — только то, на что ты сам согласишься.',
    footer: 'С теплом, Yakov Rajuna',
    switch: 'English',
  },
  en: {
    eyebrow: 'THE OPEN SKY · A FIRST ENCOUNTER',
    title: 'The Path <em>Back to Yourself</em>',
    lead: 'A space for stillness, clarity and a return to what matters.',
    body: 'I’ve put together this guide to share practices that can help you slow down, return to the present moment and reconnect with yourself. No rush. At your own pace.',
    note: 'A small step. Sometimes that is where the journey begins.',
    formLabel: 'YOUR GUIDE',
    privacy: 'Your details stay private. No noise — only what you choose to receive.',
    footer: 'With warmth, Yakov Rajuna',
    switch: 'Русский',
  },
}[lang];
---
<PageLayout title={`${m.title[lang]} — The Open Sky`} description={copy.lead}>
  <main class="guide-page" lang={lang}>
    <div class="guide-atmosphere" aria-hidden="true">
      <div class="guide-sun"></div>
      <div class="guide-arch guide-arch--outer"></div>
      <div class="guide-arch guide-arch--inner"></div>
      <div class="guide-horizon"></div>
    </div>

    <section class="guide-hero frame">
      <div class="guide-copy">
        <p class="guide-eyebrow"><span></span>{copy.eyebrow}</p>
        <h1 set:html={copy.title} />
        <p class="guide-lead">{copy.lead}</p>
        <div class="guide-rule"></div>
        <p class="guide-body">{copy.body}</p>
        <p class="guide-note">{copy.note}</p>
        <p class="guide-signature">{copy.footer}</p>
      </div>

      <aside class="guide-form-wrap" aria-label={copy.formLabel}>
        <p class="guide-form-kicker">{copy.formLabel}</p>
        <LeadForm lang={lang} slug={slug} />
        <p class="guide-privacy">{copy.privacy}</p>
      </aside>
    </section>

    <div class="guide-bottom frame">
      <span>THE OPEN SKY</span>
      <a href={lang === 'ru' ? '/en/free/free-guide' : '/free/free-guide'}>{copy.switch}</a>
      <span>BY YAKOV RAJUNA</span>
    </div>
  </main>
</PageLayout>

<style>
  .guide-page {
    position: relative; isolation: isolate; min-height: min(900px, calc(100svh - 80px));
    overflow: hidden; color: #30271e;
    background: radial-gradient(ellipse 52% 70% at 83% 20%, rgba(229,190,119,.42), transparent 72%),
      radial-gradient(ellipse 36% 48% at 12% 78%, rgba(205,173,126,.20), transparent 76%),
      linear-gradient(118deg, #f8f4eb 0%, #f2e8d5 54%, #e8d6b8 100%);
  }
  .guide-atmosphere { position:absolute; inset:0; z-index:-1; overflow:hidden; pointer-events:none; }
  .guide-sun { position:absolute; width:min(42vw,590px); aspect-ratio:1; border-radius:50%; right:7%; top:3%;
    background:radial-gradient(circle,rgba(255,246,218,.92) 0%,rgba(233,193,122,.44) 43%,rgba(190,137,72,0) 72%); filter:blur(2px); }
  .guide-arch { position:absolute; right:8%; bottom:-22%; width:min(38vw,500px); height:78%;
    border:1px solid rgba(112,78,43,.15); border-bottom:0; border-radius:48% 48% 0 0 / 34% 34% 0 0; transform:rotate(-5deg); }
  .guide-arch--inner { right:13%; bottom:-24%; width:min(28vw,365px); height:70%; border-color:rgba(112,78,43,.10); }
  .guide-horizon { position:absolute; left:0; right:0; bottom:0; height:24%; background:linear-gradient(180deg,transparent,rgba(139,104,65,.10));
    clip-path:polygon(0 55%,18% 26%,35% 62%,52% 18%,70% 58%,86% 30%,100% 54%,100% 100%,0 100%); }
  .guide-hero { min-height:min(790px,calc(100svh - 130px)); display:grid;
    grid-template-columns:minmax(0,1.08fr) minmax(350px,.72fr); align-items:center;
    gap:clamp(64px,10vw,150px); padding-top:clamp(100px,13vh,150px); padding-bottom:clamp(72px,10vh,120px); }
  .guide-copy { max-width:650px; padding-bottom:18px; }
  .guide-eyebrow,.guide-form-kicker,.guide-bottom { font-family:var(--mark); font-size:9px; font-weight:600;
    letter-spacing:.23em; text-transform:uppercase; color:#8d6b43; }
  .guide-eyebrow { display:flex; align-items:center; gap:13px; margin:0 0 35px; }
  .guide-eyebrow span { width:28px; height:1px; background:#a77b45; }
  .guide-copy h1 { max-width:700px; margin:0; color:#2b241c; font-family:var(--serif);
    font-size:clamp(64px,8.2vw,118px); line-height:.92; font-weight:400; letter-spacing:-.045em; }
  .guide-copy h1 em { color:#9c7040; font-weight:400; }
  .guide-lead { max-width:480px; margin:34px 0 0; color:#54483a; font-family:var(--display);
    font-size:clamp(22px,2.15vw,30px); line-height:1.35; font-weight:400; }
  .guide-rule { width:52px; height:1px; margin:34px 0 24px; background:#b18a58; }
  .guide-body { max-width:455px; margin:0; color:#625747; font-size:15px; line-height:1.9; font-weight:300; }
  .guide-note { margin:30px 0 0; color:#94764f; font-family:var(--serif); font-size:18px; font-style:italic; }
  .guide-signature { margin:48px 0 0; color:#8a7964; font-family:var(--serif); font-size:17px; font-style:italic; }
  .guide-form-wrap { position:relative; width:100%; max-width:440px; justify-self:end; padding:clamp(30px,4vw,48px);
    background:rgba(250,247,240,.62); border:1px solid rgba(125,91,53,.18);
    box-shadow:0 28px 80px rgba(87,61,33,.08); backdrop-filter:blur(14px); }
  .guide-form-kicker { margin:0 0 28px; color:#a17b4d; }
  .guide-privacy { margin:22px 0 0; color:#8a7b68; font-size:11px; line-height:1.7; }
  .guide-bottom { display:flex; justify-content:space-between; gap:20px; padding-top:18px; padding-bottom:26px;
    border-top:1px solid rgba(91,69,44,.13); color:rgba(91,69,44,.58); font-size:8px; letter-spacing:.2em; }
  .guide-bottom a { color:inherit; border-bottom:1px solid rgba(91,69,44,.25); }
  @media(max-width:900px) {
    .guide-hero { grid-template-columns:1fr; gap:56px; min-height:auto; }
    .guide-copy { max-width:700px; } .guide-form-wrap { justify-self:start; max-width:560px; }
    .guide-sun { width:75vw; right:-18%; top:5%; } .guide-arch { width:70vw; right:-10%; }
  }
  @media(max-width:560px) {
    .guide-hero { padding-top:94px; gap:44px; }
    .guide-eyebrow { font-size:8px; letter-spacing:.16em; margin-bottom:26px; }
    .guide-copy h1 { font-size:clamp(58px,15vw,82px); }
    .guide-lead { margin-top:25px; font-size:23px; }
    .guide-body { font-size:14px; } .guide-form-wrap { padding:27px 22px; }
    .guide-bottom { font-size:7px; }
  }
  @media(prefers-reduced-motion:reduce) { .guide-page * { scroll-behavior:auto!important; transition-duration:.01ms!important; } }
</style>
