---
import PageLayout from '../layouts/PageLayout.astro';
import LeadForm from './LeadForm.astro';
import materials from '../data/materials.json';

export interface Props { lang: 'ru' | 'en'; slug: string; }
const { lang, slug } = Astro.props;
const m = materials.materials.find((x) => x.slug === slug)!;
---

<PageLayout title={`${m.title[lang]} — The Open Sky`}>
  <section class="frame" style="padding-block: var(--s-10);">
    <LeadForm lang={lang} slug={slug} />
    <p class="t-label" style="text-align:center; margin-top: var(--s-4); color: var(--fg-soft);">
      {lang === 'ru' ? <a href="/en/free" style="display:inline-block; padding: var(--s-3) var(--s-4);">English</a> : <a href="/free?lang=ru" style="display:inline-block; padding: var(--s-3) var(--s-4);">Русский</a>}
    </p>
  </section>
</PageLayout>
