---
import materials from '../data/materials.json';

export interface Props {
  lang: 'ru' | 'en';
  slug: string;
}
const { lang, slug } = Astro.props;
const material = materials.materials.find((m) => m.slug === slug);

const T = {
  ru: {
    label: 'Бесплатный материал',
    title: 'Начни с простого',
    email: 'Твой email',
    emailHelp: 'Например: name@mail.com',
    name: 'Как к тебе обращаться',
    nameHelp: 'Напиши своё имя',
    consent: 'Хочу оставаться на связи с RAJUNA и получать письма с практиками, новыми материалами и приглашениями на ретриты и встречи.',
    consentHelp: 'По желанию. Материал будет доступен тебе и без подписки.',
    button: 'Получить материал',
    sending: 'Отправляю…',
    ok: 'Благодарю тебя. Проверь почту — там письмо с подтверждением. Нажми на кнопку внутри, и материал откроется для тебя.',
    invalid: 'Пожалуйста, проверь имя и адрес электронной почты.',
    error: 'Что-то пошло не так. Попробуй ещё раз чуть позже.',
  },
  en: {
    label: 'A free resource',
    title: 'Begin with a simple step',
    email: 'Your email address',
    emailHelp: 'For example: name@mail.com',
    name: 'Your name',
    nameHelp: 'First name',
    consent: "I'd like to stay connected with RAJUNA and receive emails with practices, new resources and invitations to retreats and gatherings.",
    consentHelp: "Optional. You'll receive the guide even if you leave this unchecked.",
    button: 'Receive the Guide',
    sending: 'Sending…',
    ok: 'Thank you. Please check your inbox for a confirmation email. Click the button inside, and your guide will be ready for you.',
    invalid: 'Please check your name and email address.',
    error: 'Something went wrong. Please try again in a little while.',
  },
}[lang];
---

{material && (
  <form class="lead-form" id="lead-form" novalidate data-lang={lang} data-slug={slug}
        data-ok={T.ok} data-invalid={T.invalid} data-error={T.error} data-sending={T.sending}>
    <span class="lead-form__eyebrow">{T.label}</span>
    <h2 class="lead-form__title">{T.title}</h2>

    <label class="lead-form__field">
      <span>{T.name}</span>
      <input type="text" name="firstName" autocomplete="given-name" required maxlength="80" />
      <small>{T.nameHelp}</small>
    </label>

    <label class="lead-form__field">
      <span>{T.email}</span>
      <input type="email" name="email" autocomplete="email" required maxlength="200" />
      <small>{T.emailHelp}</small>
    </label>

    <div class="lead-form__trap" aria-hidden="true">
      <input type="text" name="website" tabindex="-1" autocomplete="off" />
    </div>

    <label class="lead-form__consent">
      <input type="checkbox" name="consent" />
      <span>{T.consent}<small>{T.consentHelp}</small></span>
    </label>

    <button type="submit" class="btn btn--warm" data-label={T.button}>{T.button}<span aria-hidden="true">↗</span></button>
    <p class="lead-form__msg t-body" role="status" aria-live="polite"></p>
  </form>
)}

<script>
  const form = document.getElementById('lead-form') as HTMLFormElement | null;
  if (form) {
    const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    const msg = form.querySelector('.lead-form__msg') as HTMLElement;
    const source = () => {
      const p = new URLSearchParams(location.search).get('utm_source');
      if (p) return p;
      try { return document.referrer ? new URL(document.referrer).hostname : 'direct'; } catch { return 'direct'; }
    };
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fd = new FormData(form);
      const email = String(fd.get('email') || '').trim();
      const firstName = String(fd.get('firstName') || '').trim();
      if (!firstName || !/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email)) {
        msg.textContent = form.dataset.invalid || '';
        return;
      }
      btn.disabled = true;
      btn.textContent = form.dataset.sending || '';
      msg.textContent = '';
      try {
        const r = await fetch('/api/subscribe', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({
            firstName, email,
            consent: fd.get('consent') === 'on',
            website: fd.get('website') || '',
            slug: form.dataset.slug,
            lang: form.dataset.lang,
            source: source(),
          }),
        });
        if (r.ok) {
          form.reset();
          msg.textContent = form.dataset.ok || '';
          btn.style.display = 'none';
        } else {
          msg.textContent = r.status === 400 ? (form.dataset.invalid || '') : (form.dataset.error || '');
          btn.disabled = false;
          btn.textContent = btn.dataset.label || '';
        }
      } catch {
        msg.textContent = form.dataset.error || '';
        btn.disabled = false;
        btn.textContent = btn.dataset.label || '';
      }
    });
  }
</script>

<style>
  .lead-form { width:100%; max-width:none; margin:0; display:grid; gap:19px; }
  .lead-form__eyebrow { font-family:var(--mark); font-size:8px; font-weight:600; letter-spacing:.2em; text-transform:uppercase; color:#9b7548; }
  .lead-form__title { font-family:var(--serif); font-weight:400; font-size:clamp(29px,3vw,38px);
    line-height:1.08; letter-spacing:-.025em; color:#33291f; margin:-9px 0 3px; text-wrap:balance; }
  .lead-form__field { display:grid; gap:6px; font-family:var(--sans); color:#665747; font-size:12px; font-weight:500; }
  .lead-form__field input[type="text"], .lead-form__field input[type="email"] {
    width:100%; min-width:0; font:400 15px var(--sans); padding:12px 0;
    background:transparent; color:#30271e; border:0; border-bottom:1px solid rgba(105,78,48,.27);
    border-radius:0; transition:border-color 250ms ease;
  }
  .lead-form__field input:focus { outline:none; border-color:#a67c4d; box-shadow:0 1px 0 #a67c4d; }
  .lead-form__field small { display:block; color:#9a8b78; font-size:10px; line-height:1.5; font-weight:400; margin-top:2px; }
  .lead-form__consent { display:flex; gap:11px; align-items:flex-start; font-family:var(--sans);
    color:#746553; font-size:11px; line-height:1.6; font-weight:400; }
  .lead-form__consent input { flex:0 0 auto; width:14px; height:14px; margin:3px 0 0; accent-color:#987044; }
  .lead-form__consent small { display:block; font-size:10px; color:#9a8b78; margin-top:5px; }
  .lead-form__trap { position:absolute; left:-9999px; width:1px; height:1px; overflow:hidden; }
  .lead-form .btn { justify-content:space-between; width:100%; min-height:52px; margin-top:2px;
    border-radius:2px; font-family:var(--mark); font-size:9px; letter-spacing:.16em; padding:16px 20px; }
  .lead-form .btn span { font-size:18px; line-height:1; }
  .lead-form .btn:disabled { opacity:.55; cursor:wait; transform:none; }
  .lead-form__msg { min-height:1.5em; margin:0; color:#69563e; font-family:var(--sans); font-size:12px; line-height:1.6; }
  @media(max-width:560px) { .lead-form { gap:17px; } .lead-form__title { font-size:30px; } }
</style>
