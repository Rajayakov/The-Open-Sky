{
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "^(theopensky|the-open-sky|the-open-sky-rajuna|annapurna2027|annapurna-pilgrimage-2027)\\.vercel\\.app$|^the-open-sky-git-main-rajuna\\.vercel\\.app$"
        },
        {
          "type": "header",
          "key": "accept-language",
          "value": "^ja"
        }
      ],
      "destination": "https://annapurna-pilgrimage-2027.vercel.app/mountains/annapurna-2027-ja",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "^(theopensky|the-open-sky|the-open-sky-rajuna|annapurna2027|annapurna-pilgrimage-2027)\\.vercel\\.app$|^the-open-sky-git-main-rajuna\\.vercel\\.app$"
        },
        {
          "type": "header",
          "key": "accept-language",
          "value": "^(?!ru|uk|be|kk|ky|tg).+"
        }
      ],
      "destination": "https://annapurna-pilgrimage-2027.vercel.app/mountains/annapurna-2027-en",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "annapurna2027.vercel.app"
        }
      ],
      "destination": "https://annapurna-pilgrimage-2027.vercel.app/mountains/annapurna-2027",
      "permanent": false
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "annapurna2027.vercel.app"
        }
      ],
      "destination": "https://annapurna-pilgrimage-2027.vercel.app/:path*",
      "permanent": false
    },
    {
      "source": "/((?!mountains/annapurna-2027|annapurna-2027/|_vercel/|_astro/|favicon).*)",
      "has": [
        {
          "type": "host",
          "value": "^(theopensky|the-open-sky|the-open-sky-rajuna|annapurna2027|annapurna-pilgrimage-2027)\\.vercel\\.app$|^the-open-sky-git-main-rajuna\\.vercel\\.app$"
        }
      ],
      "destination": "/mountains/annapurna-2027",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/annapurna-2027/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/annapurna-2027/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
