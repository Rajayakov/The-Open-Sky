{
  "redirects": [
    { "source": "/", "has": [{ "type": "host", "value": "annapurna2027.vercel.app" }], "destination": "/mountains/annapurna-2027", "permanent": false },
    { "source": "/", "has": [{ "type": "host", "value": "annapurna-pilgrimage-2027.vercel.app" }], "destination": "/mountains/annapurna-2027", "permanent": false }
  ],
  "headers": [
    { "source": "/annapurna-2027/fonts/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/annapurna-2027/img/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }] },
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
    ] }
  ]
}
